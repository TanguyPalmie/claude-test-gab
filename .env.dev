# ── Database ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=topten
POSTGRES_USER=topten
POSTGRES_PASSWORD=topten_dev_password

# ── Backend ──────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=/data/uploads
QUESTIONS_DIR=/app/questions

# Rate limiting
RATE_LIMIT_CREATE_ROOM_WINDOW_MS=60000
RATE_LIMIT_CREATE_ROOM_MAX=10
RATE_LIMIT_JOIN_ROOM_WINDOW_MS=60000
RATE_LIMIT_JOIN_ROOM_MAX=20
BRUTE_FORCE_MAX_ATTEMPTS=10
BRUTE_FORCE_COOLDOWN_MS=60000

# Cleanup
PLAYER_CLEANUP_MINUTES=60

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
