# ── Stage: base ──────────────────────────────────────────
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# ── Stage: deps ──────────────────────────────────────────
FROM base AS deps
COPY apps/web/package.json ./
RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install

# ── Stage: dev ───────────────────────────────────────────
FROM base AS dev
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

# ── Stage: build ─────────────────────────────────────────
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
ARG VITE_API_URL
ARG VITE_WS_URL
RUN pnpm build

# ── Stage: prod (nginx) ─────────────────────────────────
# Using nginx for production because:
# - Efficient static file serving with gzip & caching
# - Handles SPA routing (try_files) natively
# - Much lower memory footprint than a Node.js process
# - Battle-tested for production traffic
FROM nginx:alpine AS prod
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
