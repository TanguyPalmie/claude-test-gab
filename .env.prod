# ── Database ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=topten
POSTGRES_USER=topten
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ── Backend ──────────────────────────────────────────────
API_PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
UPLOADS_DIR=/data/uploads
QUESTIONS_DIR=/app/questions

# Rate limiting
RATE_LIMIT_CREATE_ROOM_WINDOW_MS=60000
RATE_LIMIT_CREATE_ROOM_MAX=3
RATE_LIMIT_JOIN_ROOM_WINDOW_MS=60000
RATE_LIMIT_JOIN_ROOM_MAX=5
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_COOLDOWN_MS=300000

# Cleanup
PLAYER_CLEANUP_MINUTES=30

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=https://api.yourdomain.com
